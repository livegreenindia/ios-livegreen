# Uncomment the next line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Minimum deployment target for all pods
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Required for Xcode 15+ and some pods
      config.build_settings['ENABLE_BITCODE'] = 'NO'

    end
  end

  # Strip Razorpay linker flags and framework search paths from the aggregated
  # Pods-Runner xcconfig files so the Razorpay .framework files are not
  # linked into the Runner binary or embedded in the .ipa.
  ['debug', 'release', 'profile'].each do |cfg_name|
    xcconfig_path = File.join(
      installer.sandbox.root,
      'Target Support Files', 'Pods-Runner',
      "Pods-Runner.#{cfg_name}.xcconfig"
    )
    next unless File.exist?(xcconfig_path)
    content = File.read(xcconfig_path)
    # Remove -framework "RazorpayXxx" entries
    content = content.gsub(/ ?-framework "Razorpay[^"]*"/, '')
    # Remove Razorpay framework search path entries
    content = content.gsub(/ ?"[^"]*razorpay_flutter[^"]*\/Frameworks[^"]*"/, '')
    File.write(xcconfig_path, content)
  end

  # Remove Razorpay from the generated frameworks embed script so that the
  # Razorpay .framework bundles are not copied into Runner.app/Frameworks/.
  frameworks_script = File.join(
    installer.sandbox.root,
    'Target Support Files', 'Pods-Runner',
    'Pods-Runner-frameworks.sh'
  )
  if File.exist?(frameworks_script)
    content = File.read(frameworks_script)
    content = content.lines.reject { |l| l.match?(/[Rr]azorpay/i) }.join
    File.write(frameworks_script, content)
  end
end
